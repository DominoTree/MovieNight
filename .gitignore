# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

## Custom

# Log files
*.log

# GoCode debug file
debug

# MovieNight binary
MovieNight*

# Twitch channel info
static/subscriber.json

# This file now holds the stream key.  Don't include it.
settings.json

# vscode
.vscode

# Deploy scratch dir (used by agent for staging files into root-owned paths)
.deploy/

# hls.js downloaded by `make download-hls`; not vendored in git
static/js/hls.min.*.js

# mediamtx binary downloaded by `make download-mediamtx`
bin/

# tags for vim
tags

# channel and emote list from twitch
subscribers.json
/.settings/
/.project


# Generated by MovieNight. Do not edit by hand.
logLevel: info
logDestinations: [stdout]

# Control API (used by MovieNight to discover active publishing path)
api: yes
apiAddress: {{.ApiAddress}}

# RTMP ingest (OBS publishes here)
rtmp: yes
rtmpAddress: {{.RtmpAddress}}

# HLS Low-Latency output (consumed via reverse proxy by MovieNight)
hls: yes
hlsAddress: {{.HlsAddress}}
hlsAlwaysRemux: yes
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 200ms
hlsPartDuration: 200ms
hlsAllowOrigins: ['*']

# Disable everything else
webrtc: no
rtsp: no
srt: no
playback: no
metrics: no
pprof: no

# HTTP authentication: callback to MovieNight to validate publish stream key
authMethod: http
authHTTPAddress: http://{{.MovieNightAuthURL}}/auth/mediamtx
# Reads (HLS, API) bypass auth -- MovieNight gates HLS via its own /hls handler.
authHTTPExclude:
  - action: read
  - action: api
  - action: metrics
  - action: pprof

# Accept publishes to any subpath of "live/<key>". Auth webhook validates the key.
paths:
  ~^live/.+$:
    source: publisher
